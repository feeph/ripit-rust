// ------------------------------------------------------------------------

#[derive(Clone, Debug, PartialEq)]
pub enum FirmwareEvent {
    MSG(Message),
    DRV(DrvRecord),
    ProgressPercentage((u8, Stage, u32, f32)),
}

pub enum FirmwareError {
    ThreadError(JoinError),
}
// TODO makemkvcon f

// ------------------------------------------------------------------------

#[derive(Clone, Debug, PartialEq)]
pub enum LicenseEvent {
    MSG(Message),
    DRV(DrvRecord),
    ProgressPercentage((u8, Stage, u32, f32)),
}

pub enum LicenseError {
    ThreadError(JoinError),
}

// ------------------------------------------------------------------------
// private helper functions
// ------------------------------------------------------------------------

fn create_info_command(makemkvcon_bin: &Path, settings: &GlobalSettings, source: &Source) -> (PathBuf, Vec::<String>) {
    let program = makemkvcon_bin.to_owned();
    let args = Vec::<String>::from([
        String::from("--robot"),

        // disable scanning disc content
        if settings.disable_scan {
            String::from("--noscan")
        } else {
            String::from("")
        },

        // output all status messages to a file (default: stdout)
        match &settings.messages {
            OutputType::StdOut => String::from("--messages=-stdout"),
            OutputType::StdErr => String::from("--messages=-stderr"),
            OutputType::Silent => String::from("--messages=-none"),
            OutputType::File(filename) => format!("--messages={}", filename.to_string_lossy()),
        },

        // output all progress messages to a file (default: null)
        match &settings.progress {
            OutputType::StdOut => String::from("--progress=-stdout"),
            OutputType::StdErr => String::from("--progress=-stderr"),
            OutputType::Silent => String::from("--progress=-none"),
            OutputType::File(filename) => format!("--progress={}", filename.to_string_lossy()),
        },

        // enable debug messages
        if settings.debug {
            // !! makemkvcon's implementation is bugged and always uses
            // !! ./MakeMKV_log.txt, ignoring the user-provided filename
            // !! -> "--debug[=FILE]" does not work
            String::from("--debug")
        } else {
            String::from("")
        },

        // enables or disable direct disc access. 
        match settings.directio {
            DirectIO::Enabled => String::from("--directio=true"),
            DirectIO::Disabled => String::from("--directio=false"),
        },

        format!("--minlength={}", settings.min_length),

        String::from("info"),
        source.to_string(),
    ]).into_iter().filter(|arg| !arg.is_empty()).collect();

    (program, args)
}

fn convert_msg_record(msg: &MsgRecord, severity_map: &HashMap<u32, MsgSeverity>) -> Message {
    let severity = severity_map.get(&msg.code).unwrap_or(&MsgSeverity::Unknown);

    // TODO implement special handling for MSG:2003 since this could be a usage issue or disc error
    // make sure to use LibreDrive:
    // MSG:2003 - Error 'Scsi error - ILLEGAL REQUEST:READ OF SCRAMBLED SECTOR WITHOUT AUTHENTICATION' occurred while reading '<device>' at offset '1048576'
    // check disc for damage / dirt:
    // MSG:2003 - Error 'Scsi error - MEDIUM ERROR:L-EC UNCORRECTABLE ERROR' occurred while reading '<device>' at offset '5326917632'

    Message {
        code: msg.code,
        flags: msg.flags,
        count: msg.count,
        message: msg.message.clone(),
        format: msg.format.clone(),
        params: msg.params.clone(),
        severity: severity.clone(),
    }
}

fn create_severity_map() -> HashMap::<u32, MsgSeverity> {
    /*
        Create a HashMap for mapping message codes to severity levels.
        (see 'docs/makemkv-output.md' for examples of makemkvcon's output)

        Severities are context-dependent, e.g. 2008 (HDD too slow) and 5042 (no
        optical drive) are irrelevant when reading from a disc image but must
        be treated as an error when reading from an optical drive.
    */
    HashMap::from([
        (1003, MsgSeverity::Debug),   //
        (1004, MsgSeverity::Debug),   // 
        (1005, MsgSeverity::Info),    // MakeMkv started
        (1011, MsgSeverity::Info),    //
        (2003, MsgSeverity::Error),   // read error
        (2008, MsgSeverity::Warning), // storage slower than drive
        (2019, MsgSeverity::Error),   // file or directory not found
        (2024, MsgSeverity::Error),   // 
        (3006, MsgSeverity::Info),    // opening files on harddrive
        (3007, MsgSeverity::Info),    // using direct disc access mode
        (3025, MsgSeverity::Info),    // title is shorter than min-length
        (3026, MsgSeverity::Info),    // assuming fake title
        (3027, MsgSeverity::Info),    //
        (3028, MsgSeverity::Info),    // title was added
        (3038, MsgSeverity::Info),    // cells removed from title end
        (3041, MsgSeverity::Warning), // failed to add angle
        (3306, MsgSeverity::Info),    //
        (3307, MsgSeverity::Info),    // added file
        (3308, MsgSeverity::Info),    // added file (with angle)
        (3309, MsgSeverity::Info),    // duplicate title skipped
        (3324, MsgSeverity::Info),    // processing BD+ code
        (3326, MsgSeverity::Info),    //
        (3328, MsgSeverity::Info),    // processed BD+ code
        (3338, MsgSeverity::Info),    // downloading latest SDF
        (3344, MsgSeverity::Info),    // using Java runtime
        (5001, MsgSeverity::Warning), // file already exists in filesystem
        (5003, MsgSeverity::Error),   // failed to save title
        (5004, MsgSeverity::Error),   // <num> titles saved, <num> failed
        (5005, MsgSeverity::Error),   // <num> titles saved
        (5010, MsgSeverity::Error),   //
        (5011, MsgSeverity::Info),    // operation successfully completed
        (5014, MsgSeverity::Info),    // saving title to filesystem
        (5036, MsgSeverity::Info),    // Copy complete. <num> titles saved.
        (5037, MsgSeverity::Warning), // Copy complete. <num> titles saved, <num> failed.
        (5042, MsgSeverity::Info),    // no drives found
        (5069, MsgSeverity::Noise),   // duplicates MSG:5080
        (5070, MsgSeverity::Noise),   // duplicates MSG:5081
        (5072, MsgSeverity::Info),    //
        (5075, MsgSeverity::Info),    // new version available
        (5080, MsgSeverity::Error),   // backup failed
        (5081, MsgSeverity::Info),    // backup succeeded
        (5085, MsgSeverity::Info),    // loaded content hash table
    ])
}

