#[derive(Clone, Debug, PartialEq)]
pub enum MsgSeverity {
    Error,
    Warning,
    Info,
    Debug,
    Noise,
    Unknown,
}

// similar to MsgRecord but augmented with a severity level
#[derive(Clone, Debug, PartialEq)]
pub struct Message {
    pub code: u32,
    pub flags: u32,
    pub count: u32,
    pub message: String,
    pub format: String,
    pub params: Vec<String>,
    pub severity: MsgSeverity,
}

#[derive(Clone, Debug, PartialEq)]
pub enum Stage {
    Idle,
    DriveScan,
    BackupDisc,
    Unknown,
}

#[derive(Clone, Debug, PartialEq)]
pub enum BackupEvent {
    Message(Message),
    ProgressPercentage((u8, Stage, u32, f32)),
}

// on Linux we preface the command with 'sudo' to execute the 'makemkvcon'
// command with elevated privileges, this increases the chance of LibreDrive
// working properly
#[allow(dead_code)]
#[cfg(target_os = "linux")]
fn create_backup_command(makemkvcon_bin: &Path, source_mkv: &str, target_mkv: &str, settings: GlobalSettings) -> (PathBuf, Vec::<String>) {
    // TODO configure for 'sudo' (may require the user's password!)
    // let program = PathBuf::from("sudo");
    // let args = Vec::<String>::from([
    //     String::from(makemkvcon_bin.to_string_lossy()),
    //     String::from("--robot"),

    // run without 'sudo'
    let program = makemkvcon_bin.to_owned();
    let args = Vec::<String>::from([
        String::from("--robot"),

        // disable drive scanning when using 'makemkvcon backup'
        // (we must have all the information it would provide before
        // starting the backup and thus the only thing it achieves is to
        // slow the operation, especially if there are multiple optical
        // drives)
        String::from("--noscan"),

        // output all status messages to a file (default: stdout)
        match settings.messages {
            OutputType::StdOut => String::from("--messages=-stdout"),
            OutputType::StdErr => String::from("--messages=-stderr"),
            OutputType::Silent => String::from("--messages=-none"),
            OutputType::File(filename) => format!("--messages={}", filename.to_string_lossy()),
        },

        // output all progress messages to a file (default: null)
        match settings.progress {
            OutputType::StdOut => String::from("--progress=-stdout"),
            OutputType::StdErr => String::from("--progress=-stderr"),
            OutputType::Silent => String::from("--progress=-none"),
            OutputType::File(filename) => format!("--progress={}", filename.to_string_lossy()),
        },

        // enable debug messages
        // !! makemkvcon's implementation is bugged and always uses
        // !! ./MakeMKV_log.txt, ignoring the user-provided filename
        // String::from("--debug[=FILE]"), 

        // enables or disable direct disc access. 
        match settings.directio {
            DirectIO::Enabled => String::from("--directio=true"),
            DirectIO::Disabled => String::from("--directio=false"),
        },

        String::from("backup"),
        source_mkv.to_owned(),
        target_mkv.to_owned(),
    ]);

    (program, args)
}

#[allow(dead_code)]
#[cfg(target_os = "windows")]
fn create_backup_command(makemkvcon_bin: &Path, source_mkv: &str, target_mkv: &str) -> (PathBuf, Vec::<String>) {
    let program = makemkvcon_bin;
    let args = Vec::from([
        String::from("--robot"),
        String::from("backup"),
        source_mkv,
        target_mkv,
    ]);

    (program, args)
}

pub enum BackupError {
    DataError,
    ThreadError(JoinError),
}

struct BackupState {
    result: bool,
    pcr_code: u32,
    cur_stage: Stage,
}

#[derive(Debug)]
pub enum MkvError {
    ThreadError(JoinError),
}
pub struct MakeMkv {
    pub binary: PathBuf,

    pub enable_robot: bool,
    pub disable_scan: bool,
    pub debug: bool,
    pub directio: DirectIO,
    pub messages: OutputType,
    pub progress: OutputType, 
    pub min_length: usize,
}

impl MakeMkv {

    pub fn defaults(binary: PathBuf) -> Self {
        MakeMkv {
            binary,
            enable_robot: false,
            disable_scan: false,
            debug: false,
            directio: DirectIO::Enabled,
            messages: OutputType::Silent,
            progress: OutputType::Silent, 
            min_length: 120,
        }
    }

    // --------------------------------------------------------------------
    // generic command runner
    // --------------------------------------------------------------------

    pub async fn run(&self, mut args: Vec<String>, tx: Sender<MakeMkvEvent>) -> Result<DiscContent, MakeMkvError> {
        let mut args_mkv = Vec::new();

        // configure machine-readable output (CSV-like)
        //
        // This setting should be considered mandatory since without it
        // message codes unavailable and there's no way to identify a
        // message's severity without parsing the provided string.
        if self.enable_robot {
            args_mkv.push("--robot".to_string());
        }

        // configure visibility of status messages
        match &self.messages {
            OutputType::StdOut => {
                // nothing to do, it's the default
                // equivalent to '--messages=-stdout'
            },
            OutputType::StdErr => {
                args_mkv.push("--messages=-stderr".to_string());
            },
            OutputType::Silent => {
                args_mkv.push("--messages=-none".to_string());
            },
            OutputType::File(filename) => {
                args_mkv.push(format!("--messages={}", filename.to_string_lossy()));
            },
        };

        // configure visibility of progress messages
        match &self.progress {
            OutputType::StdOut => {
                args_mkv.push("--progress=-stdout".to_string());
            },
            OutputType::StdErr => {
                args_mkv.push("--progress=-stderr".to_string());
            },
            OutputType::Silent => {
                // nothing to do, it's the default
                // equivalent to '--progress=-none'
            },
            OutputType::File(filename) => {
                args_mkv.push(format!("--progress={}", filename.to_string_lossy()));
            },
        }

        // configure visibility of debug messages
        //
        // !! makemkvcon's implementation is bugged and always uses
        // !! ./MakeMKV_log.txt, ignoring the user-provided filename
        // !! -> Using "--debug[=FILE]" does NOT work.
        if self.debug {
            args_mkv.push("--debug".to_string());
        }

        // configure direct disc access
        match self.directio {
            DirectIO::Enabled => {
                // nothing to do, it's the default
                // equivalent to '--directio=true'
            },
            DirectIO::Disabled => {
                args_mkv.push("--directio=false".to_string());
            },
        }

        // configure minimum title length
        // (default value: 120 seconds)
        args_mkv.push(format!("--minlength={}", self.min_length));

        // ...and finally append the provided arguments
        args_mkv.append(&mut args);

        run_makemkvcon(self.binary.clone(), args_mkv, tx).await
    }

    // --------------------------------------------------------------------
    // as documented by `makemkvcon --help`
    // --------------------------------------------------------------------

    /// backs up disc to a hard drive
    ///
    /// calls `makemkvcon backup <source> <destination folder>`
    pub async fn backup(&self, source: String, target: PathBuf, tx: Sender<MakeMkvEvent>) -> Result<(), BackupError> {

        // e.g. `makemkvcon64.exe backup drv:0 filename.iso`
        let args = Vec::from([
            "backup".to_string(),
            source.to_string(),
            target.to_string_lossy().to_string(),
        ]);

        match self.run(args, tx).await {
            Ok(_) => Ok(()),
            Err(MakeMkvError::DataError(_)) => Err(BackupError::DataError),
        }
    }

    /// prints info about disc
    ///
    /// calls `makemkvcon info <source>`
    pub async fn info(&self, source: String, tx: Sender<MakeMkvEvent>) -> Result<(), InfoError> {

        // e.g. `makemkvcon64.exe info drv:0`
        let command = [
            &self.binary.to_string_lossy(),
            // "--debug",
            "--robot",
            "info",
            &source,
        ];
        println!("Executing command '{}'", command.join(" "));

        Ok(())
    }

    /// saves a single title to mkv file
    ///
    /// calls `makemkvcon mkv <source> <title id> <destination folder>`
    pub async fn mkv(&self, source: String, title: usize, target: PathBuf, tx: Sender<MakeMkvEvent>) -> Result<(), MkvError> {

        // e.g. `makemkvcon64.exe mkv drv:0 1 title_1.mkv`
        let command = [
            &self.binary.to_string_lossy(),
            // "--debug",
            "--robot",
            "mkv",
            &source,
            &title.to_string(),
            &target.to_string_lossy(),
        ];
        println!("Executing command '{}'", command.join(" "));

        Ok(())
    }

    /// run universal firmware tool
    /// 
    /// calls `makemkvcon f <args>`
    pub async fn f(&self, drive: String, filename: std::path::PathBuf, tx: Sender<MakeMkvEvent>) -> Result<(), FirmwareError> {

        // e.g. `makemkvcon64.exe f --all-yes -d E: rawflash -i Downgrade-Enabled-Firmware\Auto-Flash\LG-Desktop-NS60-sleep-fix\WH16NS60-1.02-MK.bin`
        let command = [
            &self.binary.to_string_lossy(),
            // "--debug",
            "--robot",
            "f",
            "--all-yes",
            "-d",
            &drive,
            "rawflash",
            "-i",
            &filename.to_string_lossy(),
        ];
        println!("Executing command '{}'", command.join(" "));

        Ok(())
    }
    
    /// enter registration key into program
    /// (beta key is published at https://forum.makemkv.com/forum/viewtopic.php?f=5&t=1053)
    ///
    /// calls `makemkvcon reg <key string or file name>`
    pub async fn reg(&self, license_key: String, tx: Sender<MakeMkvEvent>) -> Result<(), LicenseError> {

        // e.g. `makemkvcon64.exe reg T-Wa...9e`
        let command = [
            &self.binary.to_string_lossy(),
            // "--debug",
            "--robot",
            "reg",
            &license_key,
        ];
        println!("Executing command '{}'", command.join(" "));

        Ok(())
    }

}

