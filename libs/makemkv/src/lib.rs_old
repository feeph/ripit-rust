// TODO consider using a generic event handler instead
async fn process_info_event(event: &MakeMkvEvent, source: &Source, severity_map: &HashMap<u32, MsgSeverity>, tx: &Sender<InfoEvent>) {
    // 'makemkvcon backup' generates MSG, DRV and PRG* records
    match event {
        MakeMkvEvent::DRV(drv) => {
            debug!("info(): [{}] DRV:{} device_name: {} status:{}", source, drv.index, drv.device_name, drv.drive_status_num);
            tx.send(InfoEvent::DRV(drv.clone())).await.unwrap();
        },
        MakeMkvEvent::MSG(msg) => {
            debug!("info(): [{}] MSG:{} - {}", source, msg.code, msg.message);
            let message = convert_msg_record(msg, severity_map);
            tx.send(InfoEvent::MSG(message)).await.unwrap();
        },
        MakeMkvEvent::TCOUNT(tc) => {
            debug!("info(): [{}] TCOUNT {}", source, tc);
        },
        MakeMkvEvent::PRGT(prgt) => {
            debug!("info(): [{}] PRGT code:{}, id:{}, name:{}", source, prgt.code, prgt.id, prgt.name)
        },
        MakeMkvEvent::PRGC(prgc) => {
            debug!("info(): [{}] PRGC code:{}, id:{}, name:{}", source, prgc.code, prgc.id, prgc.name)
        },
        MakeMkvEvent::PRGV(prgv) => {
            debug!("info(): [{}] PRGV current:{}, total:{}, maximum:{}", source, prgv.current, prgv.total, prgv.maximum)
        },
    }
}

// TODO consider using a generic event handler instead
async fn process_backup_event(event: &MakeMkvEvent, disc_id: u8, backup_state: &mut BackupState, severity_map: &HashMap<u32, MsgSeverity>, tx: &Sender<BackupEvent>) {
    // 'makemkvcon backup' generates MSG, DRV and PRG* records
    match event {
        MakeMkvEvent::DRV(_) => {
            // Keep calm and do nothing.
            // We use '--noscan' to avoid disturbing other drives.
            // The generated 'DRV:' records provide no useful
            // information apart from indicating the available
            // optical drives in this computer (an information we
            // no longer need to know).
        },
        MakeMkvEvent::MSG(msg) => {
            let message = convert_msg_record(msg, severity_map);
            // MSG:5080 - Backup failed.
            // MSG:5081 - Backup done.
            if msg.code == 5081 {
                backup_state.result = true;
            }
            tx.send(BackupEvent::Message(message)).await.unwrap();
        },
        MakeMkvEvent::TCOUNT(_) => {
            // This event is not supposed to happen during backup.
            warn!("Encountered unexpected event 'TCOUNT' during backup operation. Ignoring.")
        },
        MakeMkvEvent::PRGC(prgc) => {
            backup_state.pcr_code = prgc.code;
        },
        MakeMkvEvent::PRGT(prgt) => {
            backup_state.cur_stage = match prgt.code {
                5018 => Stage::DriveScan,
                5047 => Stage::BackupDisc,
                _ => {
                    warn!("Encountered unknown stage '{}' (code: {})", prgt.name, prgt.code);
                    Stage::Unknown
                }
            }
        },
        MakeMkvEvent::PRGV(prgv) => {
            let percentage = if prgv.maximum > 0 {
                prgv.current as f32 * 100.0 / prgv.maximum as f32
            } else {
                // prevent division by zero if prgv.maximum is 0
                // (this should not happen, max is expected to be
                // set to 65536)
                0.0
            };
            let progress = (disc_id, backup_state.cur_stage.clone(), backup_state.pcr_code, percentage);
            tx.send(BackupEvent::ProgressPercentage(progress)).await.unwrap()
        },
    }
}
