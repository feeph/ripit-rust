/// a DVD, HD-DVD or Blu-Ray image (e.g. 'movie.iso')
pub struct DiscImage {
    filename: std::path::PathBuf,
}

impl DiscImage {

    // e.g. 'file://<directory>'
    fn source_mkv(&self) -> String {
        format!("file://{}", self.filename.to_string_lossy())
    }

}

#[async_trait]
impl ContentReader for DiscImage {

    async fn scan_content(&self, makemkv: MakeMkv) -> Result<(), InfoError> {
        let source = self.source_mkv();
        scan_content(makemkv, source).await
    }

    async fn extract_content(&self, makemkv: MakeMkv, titles: Vec<usize>, target: std::path::PathBuf) -> Result<(), MkvError> {
        let source = self.source_mkv();
        extract_content(makemkv, source, titles, target).await
    }

}
